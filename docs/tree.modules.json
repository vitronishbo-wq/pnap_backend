{
  "modules": {
    "backend": {
      "description": "Express API, authentication, RBAC, and backoffice endpoints.",
      "paths": [
        "server.ts",
        "server/controllers/auth.controller.ts",
        "server/controllers/backoffice.controller.ts",
        "server/middleware/rbac.middleware.ts"
      ]
    },
    "database": {
      "description": "Prisma domain model for penitentiary operations and seed data.",
      "paths": [
        "prisma/schema.prisma",
        "prisma/seed.ts"
      ]
    },
    "frontend": {
      "description": "Vite + React single-page application and UI components.",
      "paths": [
        "src/App.tsx",
        "src/main.tsx",
        "src/components/DeusFundadorPanel.tsx",
        "src/components/HealthModule.tsx",
        "src/components/QRCodeImg.tsx",
        "src/data/schemaData.ts",
        "src/utils/pdfGenerator.ts"
      ]
    },
    "configuration": {
      "description": "Project metadata, environment variables, build settings, and runtime configuration.",
      "paths": [
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
        ".env",
        ".env.example",
        "docker-compose.yml",
        "README.md"
      ]
    }
  }
}
