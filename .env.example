# ==============================================================================
# PLATAFORMA NACIONAL DE ADMINISTRAÇÃO PENITENCIÁRIA - ANGOLA (PNAP-AO)
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para .env (ou .env.local) na raiz do projeto.
# 2. Preencha os valores sensíveis (especialmente as chaves privadas e segredos).
# 3. Nunca commite o .env real; mantenha apenas o .env.example no repositório.
# ==============================================================================

# --- Configurações Gerais do Aplicativo ---
APP_NAME="PNAP-AO"
APP_URL="https://pnap-ao-5o6q.onrender.com"          # URL pública do backend
FRONTEND_URL="https://pnap-ao-5o6q.onrender.com"     # URL pública do frontend (mesmo domínio)
VITE_API_URL="https://pnap-ao-5o6q.onrender.com"     # URL que o frontend usará para chamar a API
PORT="10000"
NODE_ENV="production"
LOG_LEVEL="info"

# --- Localização e Escopo ---
COUNTRY="AO"
PNAP_COUNTRY="Angola"
DEFAULT_LANGUAGE="pt-AO"
TIMEZONE="Africa/Luanda"
PNAP_DEFAULT_PRISON_SCOPE="NATIONAL"
PNAP_MINISTRY="MININT"

# --- Segurança, Autenticação e Auditoria ---
ADMIN_BOOTSTRAP_SECRET="altere_para_um_segredo_forte"
COS_MASTER_SECRET="altere_para_um_segredo_forte"
SUPERUSER_EMAIL="admin@exemplo.gov.ao"               # E-mail do superusuário inicial
PASSWORD_HASH="bcrypt"
PASSWORD_SALT_ROUNDS="12"
AUDIT_HASH_ALGORITHM="SHA-256"
AUDIT_IMMUTABLE="true"
ENABLE_AUDIT_LOG="true"
ENABLE_NON_REPUDIATION="true"
ENABLE_REBAC="true"                                  # RBAC avançado

# --- Configurações de Tokens (JWT) ---
JWT_SECRET="altere_para_um_segredo_jwt_unico"
JWT_REFRESH_SECRET="altere_para_um_segredo_refresh_unico"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Integração com Serviços de Inteligência Artificial ---
GEMINI_API_KEY="SUA_GEMINI_API_KEY_AQUI"             # Obter em https://aistudio.google.com/

# --- Integração Firebase (Server-Side / Admin SDK & Firestore) ---
STORAGE_PROVIDER="firebase"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@pnap-ao.iam.gserviceaccount.com"
# A chave privada abaixo deve ser substituída pelo conteúdo da propriedade "private_key"
# do arquivo JSON baixado em Firebase Console > Configurações do projeto > Contas de serviço.
# Mantenha as quebras de linha (\n) ou cole o valor literal com quebras reais.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUBSTITUA_PELA_CHAVE_PRIVADA_DO_JSON_AQUI\n-----END PRIVATE KEY-----\n"

# --- Integração Firebase (Client-Side / Vite Frontend) ---
VITE_FIREBASE_PROJECT_ID="pnap-ao"
VITE_FIREBASE_STORAGE_BUCKET="pnap-ao.firebasestorage.app"
VITE_FIREBASE_API_KEY="AIzaSyAlBrirEdubhQOqEbmndS7ONeUbafFaD2o"
VITE_FIREBASE_APP_ID="1:1041660899646:web:f4dcde6893150bdb253c6f"
VITE_FIREBASE_AUTH_DOMAIN="pnap-ao.firebaseapp.com"
VITE_FIREBASE_MEASUREMENT_ID="G-ZB6FFXNENR"
VITE_FIREBASE_MESSAGING_SENDER_ID="1041660899646"

# --- Ecossistema e APIs Externas (Vitronis) ---
VITRONIS_API="https://api.vitronis.co.ao"
VITRONIS_AUTH_URL="https://vitronis.co.ao"
VITRONIS_CONSOLE="https://console.vitronis.co.ao"
VITRONIS_DOMAIN="vitronis.co.ao"
VITRONIS_ENV="production"
VITRONIS_DEFAULT_LANGUAGE="pt-AO"
VITRONIS_JWKS_URL="https://vitronis.co.ao"
VITRONIS_PLATFORM="vitronis"
VITRONIS_STATUS="https://status.vitronis.co.ao"
VITRONIS_WEB="https://vitronis.co.ao"