#############################################################
# CREDENCIAIS DO SISTEMA PNAP-AO
#############################################################
SUPERUSER_EMAIL=admin@exemplo.gov.co.ao
ADMIN_BOOTSTRAP_SECRET=sua_secret_key_aqui
COS_MASTER_SECRET=sua_master_secret_aqui

#############################################################
# APLICAÇÃO & INFRAESTRUTURA
#############################################################
NODE_ENV=production
PORT=10000
APP_NAME=PNAP-AO
APP_URL=https://sua-app.onrender.com
FRONTEND_URL=https://sua-app.onrender.com
COUNTRY=AO
DEFAULT_LANGUAGE=pt-AO
TIMEZONE=Africa/Luanda
LOG_LEVEL=info

#############################################################
# GOOGLE AI STUDIO (Gemini API)
#############################################################
GEMINI_API_KEY=sua_gemini_api_key_aqui

#############################################################
# FIREBASE WEB CONFIG (Client-side / Vite)
#############################################################
VITE_FIREBASE_API_KEY=sua_firebase_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
VITE_FIREBASE_APP_ID=seu_app_id
VITE_FIREBASE_MEASUREMENT_ID=seu_measurement_id

#############################################################
# FIREBASE ADMIN SDK (Server-side Node.js)
#############################################################
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_ID=seu_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_RSA_AQUI\n-----END PRIVATE KEY-----\n"

#############################################################
# JWT & SEGURANÇA
#############################################################
JWT_SECRET=seu_jwt_secret_muito_seguro
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=seu_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_HASH=bcrypt
PASSWORD_SALT_ROUNDS=12
ENABLE_RBAC=true
ENABLE_AUDIT_LOG=true
ENABLE_NON_REPUDIATION=true
AUDIT_HASH_ALGORITHM=SHA-256
AUDIT_IMMUTABLE=true

#############################################################
# ECOSSISTEMA PNAP
#############################################################
PNAP_COUNTRY=Angola
PNAP_MINISTRY=MININT
PNAP_DEFAULT_PRISON_SCOPE=NATIONAL
STORAGE_PROVIDER=firebase